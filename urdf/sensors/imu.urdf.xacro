<?xml version="1.0" ?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="mainbot_imu" params="prefix parent xyz rpy">
    
    <xacro:property name="imu_size" value="0.02" />
    <xacro:property name="imu_mass" value="0.05" />

    <!-- Joint kết nối IMU vào khung xe -->
    <joint name="${prefix}imu_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}imu_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>

    <!-- Link vật lý của IMU (Tuân thủ rule: dùng khối box, không dùng mesh) -->
    <link name="${prefix}imu_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${imu_size} ${imu_size} ${imu_size}" />
        </geometry>
        <material name="red">
          <color rgba="0.8 0.0 0.0 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${imu_size} ${imu_size} ${imu_size}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${imu_mass}" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia 
          ixx="${(imu_mass*(imu_size*imu_size + imu_size*imu_size))/12}" ixy="0" ixz="0"
          iyy="${(imu_mass*(imu_size*imu_size + imu_size*imu_size))/12}" iyz="0"
          izz="${(imu_mass*(imu_size*imu_size + imu_size*imu_size))/12}" />
      </inertial>
    </link>

    <!-- Plugin IMU cho Gazebo Harmonic -->
    <gazebo reference="${prefix}imu_link">
      <sensor type="imu" name="${prefix}imu_sensor">
        <topic>/imu/data</topic>
        <gz_frame_id>${prefix}imu_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <visualize>true</visualize>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <material>Gazebo/Red</material>
    </gazebo>
  </xacro:macro>

</robot>