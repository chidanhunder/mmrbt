<?xml version="1.0" ?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:macro name="mainbot_camera" params="prefix parent xyz rpy">
    
    <xacro:property name="cam_size" value="0.03" /> <xacro:property name="cam_mass" value="0.05" /> <joint name="${prefix}camera_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}camera_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>

    <link name="${prefix}camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${cam_size} ${cam_size} ${cam_size}" />
        </geometry>
        <material name="red">
          <color rgba="0.8 0.0 0.0 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${cam_size} ${cam_size} ${cam_size}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${cam_mass}" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia 
          ixx="${(cam_mass * (cam_size*cam_size + cam_size*cam_size)) / 12}" ixy="0.0" ixz="0.0"
          iyy="${(cam_mass * (cam_size*cam_size + cam_size*cam_size)) / 12}" iyz="0.0"
          izz="${(cam_mass * (cam_size*cam_size + cam_size*cam_size)) / 12}" />
      </inertial>
    </link>

    <joint name="${prefix}camera_optical_joint" type="fixed">
      <parent link="${prefix}camera_link" />
      <child link="${prefix}camera_link_optical" />
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>
    <link name="${prefix}camera_link_optical" />

    <gazebo reference="${prefix}camera_link">
      <sensor name="${prefix}camera_sensor" type="camera">
        <topic>/camera/image_raw</topic>
        <gz_frame_id>${prefix}camera_link_optical</gz_frame_id>
        <update_rate>30.0</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <camera name="${prefix}camera">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>8.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </camera>
      </sensor>
      <material>Gazebo/Red</material>
    </gazebo>

  </xacro:macro>
</robot>